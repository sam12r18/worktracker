<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <SolidColorBrush x:Key="WtWindowBrush" Color="#F5F7FB"/><SolidColorBrush x:Key="WtPanelBrush" Color="#FFFFFF"/><SolidColorBrush x:Key="WtBorderBrush" Color="#E1E6EF"/><SolidColorBrush x:Key="WtPrimaryBrush" Color="#3158D4"/><SolidColorBrush x:Key="WtPrimarySoftBrush" Color="#EDF1FF"/><SolidColorBrush x:Key="WtMutedBrush" Color="#6E7A8D"/><CornerRadius x:Key="WtCardRadius">14</CornerRadius><Thickness x:Key="WtControlPadding">11,6</Thickness>
 <Style TargetType="Window"><Setter Property="Background" Value="{StaticResource WtWindowBrush}"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="12.5"/></Style>
 <Style TargetType="Button"><Setter Property="Padding" Value="{StaticResource WtControlPadding}"/><Setter Property="Margin" Value="3,0"/><Setter Property="MinHeight" Value="34"/><Setter Property="MinWidth" Value="72"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D6DDE9"/><Setter Property="BorderThickness" Value="1"/></Style>
 <Style x:Key="WtPrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{StaticResource WtPrimaryBrush}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource WtPrimaryBrush}"/></Style>
 <Style TargetType="TextBox"><Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="9,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D6DDE9"/></Style>
 <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="6,2"/></Style><Style TargetType="PasswordBox"><Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="9,0"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
 <Style x:Key="WtCard" TargetType="Border"><Setter Property="Background" Value="{StaticResource WtPanelBrush}"/><Setter Property="Padding" Value="13"/><Setter Property="CornerRadius" Value="{StaticResource WtCardRadius}"/><Setter Property="BorderBrush" Value="{StaticResource WtBorderBrush}"/><Setter Property="BorderThickness" Value="1"/></Style>
 <Style x:Key="WtMetricCard" TargetType="Border" BasedOn="{StaticResource WtCard}"><Setter Property="Margin" Value="6,0"/></Style>
 <Style x:Key="WtMutedText" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource WtMutedBrush}"/><Setter Property="FontSize" Value="11.5"/></Style>
 <Style x:Key="WtSectionLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource WtMutedBrush}"/><Setter Property="FontSize" Value="11.5"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
 <Style x:Key="WtMetricValue" TargetType="TextBlock"><Setter Property="FontSize" Value="20"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,5,0,0"/></Style>
 <Style x:Key="WtCurrentActivity" TargetType="TextBlock"><Setter Property="FontSize" Value="15.5"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,6,0,3"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
 <Style TargetType="TabControl"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{StaticResource WtBorderBrush}"/></Style><Style TargetType="TabItem"><Setter Property="Padding" Value="13,7"/></Style>
 <Style TargetType="DataGrid"><Setter Property="BorderBrush" Value="{StaticResource WtBorderBrush}"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#EEF1F6"/><Setter Property="RowBackground" Value="White"/><Setter Property="AlternatingRowBackground" Value="#FAFBFE"/></Style>
</ResourceDictionary>
