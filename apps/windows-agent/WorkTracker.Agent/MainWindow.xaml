<Window x:Class="WorkTracker.Agent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WorkTracker.Agent.Controls"
        Title="WorkTracker" Height="720" Width="1180" MinHeight="620" MinWidth="900"
        FlowDirection="RightToLeft" WindowStartupLocation="CenterScreen" Closing="Window_Closing">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Grid.Row="0" LastChildFill="False">
            <StackPanel DockPanel.Dock="Right"><TextBlock Text="WorkTracker" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="DeviceText" Margin="0,4,0,0" FontSize="11" Opacity="0.55"/></StackPanel>
            <Border x:Name="TrackingBadge" Style="{StaticResource WtStatusBadge}" Padding="10,5" CornerRadius="10" DockPanel.Dock="Left"><TextBlock x:Name="TrackingStateText" Text="در حال راه‌اندازی..." Foreground="#B7CEFF"/></Border>
        </DockPanel>
        <controls:TodaySummaryControl x:Name="TodaySummary" Grid.Row="1" Margin="0,14,0,12"/>
        <Border Grid.Row="2" Style="{StaticResource WtCard}" Padding="11" Margin="0,0,0,12">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="165"/><ColumnDefinition Width="165"/><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ComboBox x:Name="ManualProjectCombo" Grid.Column="0" MinHeight="34" DisplayMemberPath="Name" SelectedValuePath="Id" ToolTip="پروژه فعالیت دستی"/>
                <ComboBox x:Name="ManualActivityTypeCombo" Grid.Column="1" Margin="8,0,0,0" MinHeight="34" DisplayMemberPath="Name" SelectedValuePath="Id" ToolTip="نوع فعالیت برای قیمت‌گذاری"/>
                <CheckBox x:Name="ManualBillableCheckBox" Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" IsThreeState="True" IsChecked="{x:Null}" Content="صورتحساب" ToolTip="سه حالت: بله، خیر، یا استفاده از پیش‌فرض پروژه/نوع فعالیت"/>
                <TextBox x:Name="ManualNoteTextBox" Grid.Column="3" Margin="8,0" MinHeight="34" VerticalContentAlignment="Center" Padding="8,0" ToolTip="توضیح فعالیت دستی"/>
                <ListBox x:Name="ActiveManualTimersList" Grid.Column="4" Margin="4,0" MinHeight="48"/>
                <StackPanel Grid.Column="5"><StackPanel Orientation="Horizontal"><Button Style="{StaticResource WtPrimaryButton}" Content="شروع تایمر" Click="StartManualTimerButton_Click"/><Button Content="پایان انتخاب‌شده" Click="StopManualTimerButton_Click" Margin="6,0,0,0"/></StackPanel><Button x:Name="TrackingButton" Content="توقف ردیابی" Click="TrackingButton_Click" Margin="0,6,0,0"/></StackPanel>
            </Grid>
        </Border>
        <TabControl Grid.Row="3">
            <TabItem Header="Timeline امروز"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><TextBlock Text="Timeline امروز — هم‌پوشانی‌ها مستقل و additive هستند." FontWeight="SemiBold"/><StackPanel DockPanel.Dock="Left" Orientation="Horizontal"><ComboBox x:Name="TimelineActivityTypeCombo" Width="150" DisplayMemberPath="Name" SelectedValuePath="Id" ToolTip="نوع فعالیت برای ردیف انتخاب‌شده"/><CheckBox x:Name="TimelineBillableCheckBox" IsThreeState="True" IsChecked="{x:Null}" Margin="8,0" VerticalAlignment="Center" Content="صورتحساب"/><Button Content="اعمال نوع" Click="AssignActivityTypeButton_Click"/><Button Content="بروزرسانی" Click="RefreshButton_Click" Margin="6,0,0,0"/></StackPanel></DockPanel><ListView x:Name="ActivitiesList" Grid.Row="1" Margin="0,10,0,0"><ListView.View><GridView><GridViewColumn Header="زمان" Width="140" DisplayMemberBinding="{Binding Time}"/><GridViewColumn Header="برنامه" Width="140" DisplayMemberBinding="{Binding Application}"/><GridViewColumn Header="پروژه" Width="160" DisplayMemberBinding="{Binding Project}"/><GridViewColumn Header="نوع فعالیت" Width="130" DisplayMemberBinding="{Binding ActivityType}"/><GridViewColumn Header="عنوان / توضیح" Width="360" DisplayMemberBinding="{Binding Title}"/><GridViewColumn Header="مدت" Width="90" DisplayMemberBinding="{Binding Duration}"/><GridViewColumn Header="منبع" Width="100" DisplayMemberBinding="{Binding Source}"/></GridView></ListView.View></ListView></Grid></TabItem>
            <TabItem Header="تشخیص‌داده‌نشده"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="یک Activity را انتخاب کن، پروژه را تعیین کن؛ در صورت تمایل از عنوان پنجره Rule بساز." VerticalAlignment="Center"/><ComboBox x:Name="UnknownProjectCombo" Grid.Column="1" Margin="8,0" MinHeight="32" DisplayMemberPath="Name" SelectedValuePath="Id"/><StackPanel Grid.Column="2" Orientation="Horizontal"><Button Content="انتساب پروژه" Click="AssignUnknownButton_Click"/><Button Content="انتساب + یادگیری" Click="AssignAndLearnButton_Click" Margin="6,0,0,0"/></StackPanel></Grid><ListView x:Name="UnknownActivitiesList" Grid.Row="1" Margin="0,10,0,0"><ListView.View><GridView><GridViewColumn Header="زمان" Width="140" DisplayMemberBinding="{Binding Time}"/><GridViewColumn Header="برنامه" Width="150" DisplayMemberBinding="{Binding Application}"/><GridViewColumn Header="عنوان پنجره" Width="520" DisplayMemberBinding="{Binding Title}"/><GridViewColumn Header="مدت" Width="100" DisplayMemberBinding="{Binding Duration}"/></GridView></ListView.View></ListView></Grid></TabItem>
            <TabItem Header="پروژه‌ها و Ruleها"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="NewProjectNameTextBox" MinHeight="34" VerticalContentAlignment="Center" Padding="8,0" ToolTip="نام پروژه جدید"/><TextBox x:Name="NewProjectCodeTextBox" Grid.Column="1" Margin="8,0" MinHeight="34" VerticalContentAlignment="Center" Padding="8,0" ToolTip="کد اختیاری"/><Button Grid.Column="2" Content="افزودن پروژه" Click="AddProjectButton_Click"/></Grid><DataGrid x:Name="RulesGrid" Grid.Row="1" Margin="0,10,0,0" IsReadOnly="True" AutoGenerateColumns="True"/></Grid></TabItem>
            <TabItem Header="همگام‌سازی"><Grid Margin="14" MaxWidth="820" HorizontalAlignment="Right"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><TextBlock Text="اتصال امن Windows Agent به Laravel API" FontSize="17" FontWeight="SemiBold"/><Button Content="کپی شناسه کامل دستگاه" Click="CopyDeviceIdButton_Click" Margin="12,0,0,0" Padding="8,3"/></StackPanel><Grid Grid.Row="1" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="آدرس API" VerticalAlignment="Center"/><TextBox x:Name="ApiUrlTextBox" Grid.Column="1" MinHeight="34" Padding="8,0" VerticalContentAlignment="Center" ToolTip="مثال: https://tracker.example.com"/></Grid><Grid Grid.Row="2" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Sanctum Token" VerticalAlignment="Center"/><PasswordBox x:Name="SyncTokenPasswordBox" Grid.Column="1" MinHeight="34" Padding="8,0" VerticalContentAlignment="Center"/><Button Grid.Column="2" Content="حذف Token" Click="ClearSyncTokenButton_Click" Margin="8,0,0,0"/><TextBlock x:Name="TokenStateText" Grid.Column="1" Margin="0,38,0,0" FontSize="11" Opacity="0.6"/></Grid><StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,34,0,0"><Button Content="ذخیره و تست اتصال" Click="SaveSyncSettingsButton_Click"/><Button Content="Sync اکنون" Click="SyncNowButton_Click" Margin="8,0,0,0"/><StackPanel Margin="14,0,0,0"><TextBlock x:Name="SyncStatusText" Text="Sync پیکربندی نشده"/><TextBlock x:Name="LastSyncText" Text="آخرین Sync: -" FontSize="11" Opacity="0.6"/></StackPanel></StackPanel><Grid Grid.Row="4" Margin="0,18,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock TextWrapping="Wrap" Opacity="0.7" Text="Token با Windows DPAPI و برای حساب کاربری فعلی ویندوز محافظت می‌شود. Activityها ابتدا در SQLite ثبت می‌شوند؛ قطع اینترنت ردیابی را متوقف نمی‌کند. Project و Ruleها بین دستگاه‌ها Pull می‌شوند، اما Timeline محلی دستگاه دیگر به این دستگاه تزریق نمی‌شود."/><DataGrid x:Name="SyncConflictsGrid" Grid.Row="1" Margin="0,12,0,0" MinHeight="150" IsReadOnly="True" AutoGenerateColumns="True"/></Grid></Grid></TabItem>
        </TabControl>
        <DockPanel Grid.Row="4" Margin="0,8,0,0" LastChildFill="False"><TextBlock DockPanel.Dock="Right" Text="بستن پنجره، برنامه را به System Tray می‌فرستد." Opacity="0.55" FontSize="11"/><Button DockPanel.Dock="Left" Content="خروج کامل" Click="ExitButton_Click" Padding="10,4"/></DockPanel>
    </Grid>
</Window>
