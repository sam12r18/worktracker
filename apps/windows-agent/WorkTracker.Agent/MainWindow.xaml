<Window x:Class="WorkTracker.Agent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WorkTracker.Agent.Controls"
        Title="WorkTracker"
        Height="760"
        Width="1220"
        MinHeight="640"
        MinWidth="940"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing"
        Background="{StaticResource WtWindowBrush}"
        Foreground="{StaticResource WtTextBrush}">
    <Grid Margin="18" Background="{StaticResource WtWindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False">
            <StackPanel DockPanel.Dock="Right">
                <TextBlock Text="WorkTracker" FontSize="25" FontWeight="SemiBold"/>
                <TextBlock x:Name="DeviceText" Margin="0,4,0,0" FontSize="11" Opacity="0.55"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" FlowDirection="LeftToRight">
                <Button Content="ویجت فعالیت" Click="ShowWidgetButton_Click" MinHeight="30" Padding="9,3" Margin="0,0,8,0"/>
                <Border x:Name="TrackingBadge"
                        Style="{StaticResource WtStatusBadge}"
                        Padding="10,5"
                        CornerRadius="10">
                    <TextBlock x:Name="TrackingStateText" Text="در حال راه‌اندازی..." Foreground="#B7CEFF"/>
                </Border>
            </StackPanel>
        </DockPanel>

        <controls:TodaySummaryControl x:Name="TodaySummary" Grid.Row="1" Margin="0,14,0,12"/>

        <Border Grid.Row="2" Style="{StaticResource WtCard}" Padding="11" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="165"/>
                    <ColumnDefinition Width="165"/>
                    <ColumnDefinition Width="105"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="ManualProjectCombo"
                          Grid.Column="0"
                          MinHeight="34"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id"
                          ToolTip="پروژه فعالیت دستی"/>
                <ComboBox x:Name="ManualActivityTypeCombo"
                          Grid.Column="1"
                          Margin="8,0,0,0"
                          MinHeight="34"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id"
                          ToolTip="نوع فعالیت برای قیمت‌گذاری"/>
                <CheckBox x:Name="ManualBillableCheckBox"
                          Grid.Column="2"
                          Margin="8,0,0,0"
                          VerticalAlignment="Center"
                          IsThreeState="True"
                          IsChecked="{x:Null}"
                          Content="صورتحساب"
                          ToolTip="سه حالت: بله، خیر، یا استفاده از پیش‌فرض پروژه/نوع فعالیت"/>
                <TextBox x:Name="ManualNoteTextBox"
                         Grid.Column="3"
                         Margin="8,0"
                         MinHeight="34"
                         VerticalContentAlignment="Center"
                         Padding="8,0"
                         ToolTip="توضیح فعالیت دستی"/>
                <ListBox x:Name="ActiveManualTimersList" Grid.Column="4" Margin="4,0" MinHeight="48"/>
                <StackPanel Grid.Column="5">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource WtPrimaryButton}" Content="شروع تایمر" Click="StartManualTimerButton_Click"/>
                        <Button Content="پایان انتخاب‌شده" Click="StopManualTimerButton_Click" Margin="6,0,0,0"/>
                    </StackPanel>
                    <Button x:Name="TrackingButton" Content="توقف ردیابی" Click="TrackingButton_Click" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="3">
            <TabItem Header="Timeline امروز">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <TextBlock Text="Timeline امروز — بخش‌های foreground به رویداد کاری تجمیع می‌شوند و هم‌پوشانی additive حفظ می‌شود." FontWeight="SemiBold"/>
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <ComboBox x:Name="TimelineActivityTypeCombo"
                                      Width="150"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Id"
                                      ToolTip="نوع فعالیت برای تمام بخش‌های رویداد انتخاب‌شده"/>
                            <CheckBox x:Name="TimelineBillableCheckBox"
                                      IsThreeState="True"
                                      IsChecked="{x:Null}"
                                      Margin="8,0"
                                      VerticalAlignment="Center"
                                      Content="صورتحساب"/>
                            <Button Content="اعمال نوع" Click="AssignActivityTypeButton_Click"/>
                            <Button Content="بروزرسانی" Click="RefreshButton_Click" Margin="6,0,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <ListView x:Name="ActivitiesList" Grid.Row="1" Margin="0,10,0,0">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="زمان" Width="140" DisplayMemberBinding="{Binding Time}"/>
                                <GridViewColumn Header="برنامه" Width="140" DisplayMemberBinding="{Binding Application}"/>
                                <GridViewColumn Header="پروژه" Width="160" DisplayMemberBinding="{Binding Project}"/>
                                <GridViewColumn Header="نوع فعالیت" Width="130" DisplayMemberBinding="{Binding ActivityType}"/>
                                <GridViewColumn Header="عنوان / توضیح" Width="360" DisplayMemberBinding="{Binding Title}"/>
                                <GridViewColumn Header="مدت" Width="90" DisplayMemberBinding="{Binding Duration}"/>
                                <GridViewColumn Header="جزئیات" Width="190" DisplayMemberBinding="{Binding Detail}"/>
                                <GridViewColumn Header="منبع" Width="150" DisplayMemberBinding="{Binding Source}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </TabItem>

            <TabItem Header="تشخیص‌داده‌نشده">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="210"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="یک رویداد را انتخاب کن و پروژه را تعیین کن؛ «یادگیری» برای IDE از الگوی پایدار Workspace استفاده می‌کند، نه نام هر فایل."
                                   VerticalAlignment="Center"/>
                        <ComboBox x:Name="UnknownProjectCombo"
                                  Grid.Column="1"
                                  Margin="8,0"
                                  MinHeight="32"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Content="انتساب پروژه" Click="AssignUnknownButton_Click"/>
                            <Button Content="انتساب + یادگیری" Click="AssignAndLearnButton_Click" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Grid>
                    <ListView x:Name="UnknownActivitiesList" Grid.Row="1" Margin="0,10,0,0">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="زمان" Width="140" DisplayMemberBinding="{Binding Time}"/>
                                <GridViewColumn Header="برنامه" Width="150" DisplayMemberBinding="{Binding Application}"/>
                                <GridViewColumn Header="عنوان پنجره" Width="520" DisplayMemberBinding="{Binding Title}"/>
                                <GridViewColumn Header="مدت" Width="100" DisplayMemberBinding="{Binding Duration}"/>
                                <GridViewColumn Header="جزئیات" Width="190" DisplayMemberBinding="{Binding Detail}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </TabItem>

            <TabItem Header="تشخیص‌داده‌شده">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="رویدادهای دارای پروژه" FontWeight="SemiBold"/>
                            <TextBlock Text="برای اصلاح تشخیص، رویداد را انتخاب کن و پروژه جدید را تعیین کن. اصلاح روی تمام بخش‌های همان رویداد اعمال می‌شود و یادگیری الگوی پایدار Context را می‌سازد."
                                       Margin="0,3,0,0"
                                       FontSize="11"
                                       Opacity="0.65"/>
                        </StackPanel>
                        <ComboBox x:Name="AssignedProjectCombo"
                                  Grid.Column="1"
                                  Margin="8,0"
                                  MinHeight="32"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Content="تغییر انتساب" Click="ReassignDetectedButton_Click"/>
                            <Button Content="انتساب + یادگیری" Click="ReassignDetectedAndLearnButton_Click" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Grid>
                    <ListView x:Name="AssignedActivitiesList"
                              Grid.Row="1"
                              Margin="0,10,0,0"
                              SelectionChanged="AssignedActivitiesList_SelectionChanged">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="زمان" Width="140" DisplayMemberBinding="{Binding Time}"/>
                                <GridViewColumn Header="برنامه" Width="145" DisplayMemberBinding="{Binding Application}"/>
                                <GridViewColumn Header="پروژه فعلی" Width="180" DisplayMemberBinding="{Binding Project}"/>
                                <GridViewColumn Header="نوع فعالیت" Width="130" DisplayMemberBinding="{Binding ActivityType}"/>
                                <GridViewColumn Header="عنوان / Context" Width="360" DisplayMemberBinding="{Binding Title}"/>
                                <GridViewColumn Header="مدت" Width="90" DisplayMemberBinding="{Binding Duration}"/>
                                <GridViewColumn Header="جزئیات" Width="190" DisplayMemberBinding="{Binding Detail}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </TabItem>

            <TabItem Header="پروژه‌ها و Ruleها">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="NewProjectNameTextBox" MinHeight="34" VerticalContentAlignment="Center" Padding="8,0" ToolTip="نام پروژه جدید"/>
                        <TextBox x:Name="NewProjectCodeTextBox" Grid.Column="1" Margin="8,0" MinHeight="34" VerticalContentAlignment="Center" Padding="8,0" ToolTip="کد اختیاری"/>
                        <Button Grid.Column="2" Content="افزودن پروژه" Click="AddProjectButton_Click"/>
                    </Grid>
                    <DataGrid x:Name="RulesGrid" Grid.Row="1" Margin="0,10,0,0" IsReadOnly="True" AutoGenerateColumns="True"/>
                </Grid>
            </TabItem>

            <TabItem Header="همگام‌سازی">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Left"
                                    Content="کپی شناسه دستگاه"
                                    Click="CopyDeviceIdButton_Click"
                                    Padding="10,4"/>
                            <StackPanel>
                                <TextBlock Text="همگام‌سازی با Laravel API" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="وضعیت اتصال، صف ارسال، تنظیمات دریافت‌شده و تعارض‌ها را از همین صفحه کنترل کن."
                                           Margin="0,4,0,0"
                                           FontSize="11.5"
                                           Opacity="0.65"/>
                            </StackPanel>
                        </DockPanel>

                        <Grid Grid.Row="1" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource WtCard}" Padding="14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="اتصال و احراز هویت" FontWeight="SemiBold" FontSize="14"/>
                                    <Grid Grid.Row="1" Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="105"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="آدرس API" VerticalAlignment="Center" Opacity="0.75"/>
                                        <TextBox x:Name="ApiUrlTextBox"
                                                 Grid.Column="1"
                                                 MinHeight="34"
                                                 Padding="8,0"
                                                 VerticalContentAlignment="Center"
                                                 FlowDirection="LeftToRight"
                                                 ToolTip="مثال: https://tracker.example.com"/>
                                    </Grid>
                                    <Grid Grid.Row="2" Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="105"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Sanctum Token" VerticalAlignment="Center" Opacity="0.75"/>
                                        <StackPanel Grid.Column="1">
                                            <PasswordBox x:Name="SyncTokenPasswordBox" MinHeight="34" Padding="8,0" VerticalContentAlignment="Center"/>
                                            <TextBlock x:Name="TokenStateText" Margin="0,5,0,0" FontSize="11" Opacity="0.6"/>
                                        </StackPanel>
                                        <Button Grid.Column="2"
                                                Style="{StaticResource WtDangerButton}"
                                                Content="حذف Token"
                                                Click="ClearSyncTokenButton_Click"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Top"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource WtCard}" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="وضعیت همگام‌سازی" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock x:Name="SyncStatusText" Text="Sync پیکربندی نشده" Margin="0,12,0,0" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="LastSyncText" Text="آخرین Sync: -" Margin="0,7,0,0" FontSize="11" Opacity="0.65"/>
                                    <TextBlock x:Name="LocalConfigText" Text="پروژه محلی: - · نوع فعالیت: -" Margin="0,5,0,0" FontSize="11" Opacity="0.65"/>
                                    <TextBlock x:Name="IdeContextStatusText" Text="PhpStorm Context: Plugin هنوز متصل نشده است." Margin="0,6,0,0" FontSize="11" Opacity="0.78" TextWrapping="Wrap"/>
                                    <Separator Margin="0,10"/>
                                    <TextBlock x:Name="QueueDiagnosticsText" Text="صف: -" FontSize="11" Opacity="0.78" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Grid.Row="2" Style="{StaticResource WtCard}" Padding="12" Margin="0,12,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="عملیات" FontWeight="SemiBold" FontSize="13"/>
                                <WrapPanel Grid.Row="1" Margin="0,10,0,0">
                                    <Button Style="{StaticResource WtPrimaryButton}" Content="ذخیره و تست اتصال" Click="SaveSyncSettingsButton_Click"/>
                                    <Button Content="Sync اکنون" Click="SyncNowButton_Click" Margin="7,0,0,0"/>
                                    <Button Content="بازخوانی کامل تنظیمات" Click="FullPullButton_Click" Margin="7,0,0,0"
                                            ToolTip="بدون ارسال Activityهای صف، Cursor محلی را پاک می‌کند و Project، Rule و Activity Typeها را از ابتدا Pull می‌کند."/>
                                    <Button Content="تلاش مجدد صف" Click="RetryQueueButton_Click" Margin="7,0,0,0"
                                            ToolTip="Backoff موارد تاخیری را صفر می‌کند و بدون حذف داده، آن‌ها را دوباره برای Sync آماده می‌کند."/>
                                </WrapPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="3" Style="{StaticResource WtCard}" Padding="12" Margin="0,12,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="تعارض‌های باز" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Grid.Row="1"
                                           Margin="0,4,0,0"
                                           TextWrapping="Wrap"
                                           Opacity="0.62"
                                           FontSize="11"
                                           Text="Activityها ابتدا در SQLite ذخیره می‌شوند و قطع اینترنت ردیابی را متوقف نمی‌کند. Project، Rule و Activity Typeها از سرور Pull می‌شوند؛ Timeline دستگاه‌های دیگر به این دستگاه تزریق نمی‌شود."/>
                                <DataGrid x:Name="SyncConflictsGrid"
                                          Grid.Row="2"
                                          Margin="0,10,0,0"
                                          MinHeight="120"
                                          MaxHeight="220"
                                          IsReadOnly="True"
                                          AutoGenerateColumns="True"/>
                            </Grid>
                        </Border>

                        <TextBlock Grid.Row="4"
                                   Margin="2,10,2,2"
                                   TextWrapping="Wrap"
                                   Opacity="0.5"
                                   FontSize="10.5"
                                   Text="Token با Windows DPAPI برای حساب کاربری فعلی ویندوز محافظت می‌شود. برای عیب‌یابی جزئیات درخواست‌ها و پاسخ‌ها از تب «لاگ‌ها» استفاده کن."/>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="لاگ‌ها">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="لاگ تشخیصی WorkTracker Agent" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Margin="0,5,0,0"
                                   Opacity="0.7"
                                   TextWrapping="Wrap"
                                   Text="رویدادهای Sync، HTTP، صف Outbox و خطاها ثبت می‌شوند. Token و Authorization در لاگ ذخیره نمی‌شوند. برای بررسی مشکل Sync، این بخش یا فایل لاگ را ارسال کنید."/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,10">
                        <Button Content="بروزرسانی لاگ" Click="RefreshLogsButton_Click"/>
                        <Button Content="کپی لاگ" Click="CopyLogsButton_Click" Margin="8,0,0,0"/>
                        <Button Content="باز کردن پوشه لاگ" Click="OpenLogsFolderButton_Click" Margin="8,0,0,0"/>
                        <Button Style="{StaticResource WtDangerButton}" Content="پاک کردن لاگ‌ها" Click="ClearLogsButton_Click" Margin="8,0,0,0"/>
                        <TextBlock x:Name="LogPathText"
                                   Margin="14,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Opacity="0.65"
                                   FlowDirection="LeftToRight"/>
                    </StackPanel>
                    <TextBox x:Name="SyncLogTextBox"
                             Grid.Row="2"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             FontSize="11"
                             FlowDirection="LeftToRight"
                             Padding="10"/>
                </Grid>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="4" Margin="0,8,0,0" LastChildFill="False">
            <TextBlock DockPanel.Dock="Right" Text="بستن پنجره، برنامه را به System Tray می‌فرستد." Opacity="0.55" FontSize="11"/>
            <Button DockPanel.Dock="Left" Content="خروج کامل" Click="ExitButton_Click" Padding="10,4"/>
        </DockPanel>
    </Grid>
</Window>
