<Window x:Class="WorkTracker.Agent.ProjectPulseWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WorkTracker Pulse"
        Width="330"
        Height="292"
        MinWidth="300"
        MinHeight="255"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Topmost="True"
        FlowDirection="RightToLeft"
        Background="{StaticResource WtWindowBrush}"
        Foreground="{StaticResource WtTextBrush}"
        Closing="Window_Closing"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Border Background="{StaticResource WtWindowBrush}"
            BorderBrush="{StaticResource WtBorderStrongBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" FlowDirection="LeftToRight">
                    <Button Content="×" Width="30" MinWidth="30" Height="30" MinHeight="30" Padding="0" Click="HideButton_Click" ToolTip="پنهان کردن ویجت"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="فعالیت‌های اخیر" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock x:Name="WidgetStateText" Text="سه پروژه آخر · زمان اعتباری امروز" Margin="0,3,0,0" FontSize="10.5" Foreground="{StaticResource WtMutedBrush}"/>
                </StackPanel>
            </DockPanel>

            <ItemsControl x:Name="PulseRowsList" Grid.Row="1" Margin="0,10,0,8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource WtPanelBrush}"
                                BorderBrush="{StaticResource WtBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="9,7"
                                Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" Margin="0,5,0,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{StaticResource WtMutedBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Fill" Value="{StaticResource WtSuccessBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding Project}" Margin="6,0,0,0" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Application}" Margin="13,3,0,0" FontSize="10.5" Foreground="{StaticResource WtMutedBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Margin="13,2,0,0" FontSize="9.5" Foreground="{StaticResource WtMutedBrush}">
                                        <Run Text="مستقیم "/><Run Text="{Binding Direct}"/><Run Text=" · تداوم "/><Run Text="{Binding Bridge}"/>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding Duration}" FontFamily="Consolas" FontSize="17" FontWeight="SemiBold" FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding State}" FontSize="9.5" Foreground="{StaticResource WtMutedBrush}" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Grid.Row="2" Background="{StaticResource WtPanelAltBrush}" CornerRadius="8" Padding="8,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Effort" FontSize="9" Foreground="{StaticResource WtMutedBrush}"/>
                        <TextBlock x:Name="PulseEffortText" Text="00:00:00" FontFamily="Consolas" FontWeight="SemiBold" FlowDirection="LeftToRight"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Coverage" FontSize="9" Foreground="{StaticResource WtMutedBrush}"/>
                        <TextBlock x:Name="PulseCoverageText" Text="00:00:00" FontFamily="Consolas" FontWeight="SemiBold" FlowDirection="LeftToRight"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Concurrent" FontSize="9" Foreground="{StaticResource WtMutedBrush}"/>
                        <TextBlock x:Name="PulseConcurrentText" Text="00:00:00" FontFamily="Consolas" FontWeight="SemiBold" FlowDirection="LeftToRight"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
