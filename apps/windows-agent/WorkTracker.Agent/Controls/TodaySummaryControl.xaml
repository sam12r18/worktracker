<UserControl x:Class="WorkTracker.Agent.Controls.TodaySummaryControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2.2*"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Style="{StaticResource WtCard}" Margin="0,0,6,0"><StackPanel><TextBlock Text="فعالیت فعلی" Style="{StaticResource WtSectionLabel}"/><TextBlock Text="{Binding CurrentActivity,RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource WtCurrentActivity}"/><TextBlock Text="{Binding CurrentProcess,RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource WtMutedText}"/></StackPanel></Border>
  <Border Grid.Column="1" Style="{StaticResource WtMetricCard}"><StackPanel><TextBlock Text="Effort" Style="{StaticResource WtSectionLabel}"/><TextBlock Text="{Binding Effort,RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource WtMetricValue}"/></StackPanel></Border>
  <Border Grid.Column="2" Style="{StaticResource WtMetricCard}"><StackPanel><TextBlock Text="Coverage" Style="{StaticResource WtSectionLabel}"/><TextBlock Text="{Binding Coverage,RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource WtMetricValue}"/></StackPanel></Border>
  <Border Grid.Column="3" Style="{StaticResource WtMetricCard}"><StackPanel><TextBlock Text="Concurrent" Style="{StaticResource WtSectionLabel}"/><TextBlock Text="{Binding Concurrent,RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource WtMetricValue}"/></StackPanel></Border>
  <Border Grid.Column="4" Style="{StaticResource WtMetricCard}" Margin="6,0,0,0"><StackPanel><TextBlock Text="Unknown / Sync" Style="{StaticResource WtSectionLabel}"/><TextBlock Text="{Binding UnknownSync,RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource WtMetricValue}"/></StackPanel></Border>
 </Grid>
</UserControl>
